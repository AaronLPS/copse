{
  "name": "@aaronlps/copse",
  "version": "0.4.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Many agent sessions, one repository, no collisions.",
  "keywords": [
    "git",
    "worktree",
    "cli",
    "agent",
    "multi-agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "copse": "src/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronLPS/copse.git"
  },
  "bugs": {
    "url": "https://github.com/AaronLPS/copse/issues"
  },
  "homepage": "https://github.com/AaronLPS/copse#readme",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** test/*.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:agents:live": "node scripts/live-agent-smoke.mjs"
  },
  "license": "MIT"
}
