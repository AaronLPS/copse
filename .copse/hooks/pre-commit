#!/bin/sh
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
'node' 'src/cli.mjs' hook pre-commit "$@" || exit $?
previous=$(git config --local --get copse.previousHooksPath || true)
[ -n "$previous" ] || exit 0
if [ "$previous" = '.copse/hooks' ]; then
  echo 'copse: Git hook delegation cycle points back to .copse/hooks' >&2
  exit 1
fi
commonDir=$(git rev-parse --git-common-dir) || exit 1
case "$commonDir" in
  /*) ;;
  *) commonDir="$root/$commonDir" ;;
esac
case "$previous" in
  '<default>') delegated="$commonDir/hooks/pre-commit" ;;
  /*) delegated="$previous/pre-commit" ;;
  *) delegated="$root/$previous/pre-commit" ;;
esac
[ -x "$delegated" ] || exit 0
"$delegated" "$@"
status=$?
exit "$status"
